# Supabase Configuration
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# RevenueCat Configuration
# Public SDK API key from RevenueCat dashboard
# It starts with "appl_" for iOS and "goog_" for Android
EXPO_PUBLIC_REVENUECAT_APPLE_KEY=appl_YOUR_APPLE_KEY_HERE
EXPO_PUBLIC_REVENUECAT_GOOGLE_KEY=goog_YOUR_GOOGLE_KEY_HERE

# RevenueCat Webhook Configuration (for Supabase Edge Functions)
# Generate this in RevenueCat Dashboard > Project Settings > Integrations > Webhooks
# Used to verify webhook signatures for security
REVENUECAT_WEBHOOK_SECRET=whsec_YOUR_WEBHOOK_SECRET_HERE

# RevenueCat REST API Key (optional - for server-side verification)
# Generate in RevenueCat Dashboard > Project Settings > API Keys
# Only needed if using direct API verification (adds latency)
REVENUECAT_API_KEY=sk_YOUR_API_KEY_HERE

# Bible Brain Audio API
# Request a key at https://4.dbt.io/api_key/request
BIBLE_BRAIN_API_KEY=your_bible_brain_api_key_here

# ⚠️  SERVER-ONLY SECRETS — DO NOT add these to the client .env
# These keys must ONLY exist in:
#   1. Supabase Edge Function environment variables (Dashboard → Edge Functions → Secrets)
#   2. Local terminal when running seeding scripts: SUPABASE_SERVICE_ROLE_KEY=... node script.js
# NEVER commit or bundle these into the React Native app.
#
# SUPABASE_SERVICE_ROLE_KEY — full admin access to Supabase (server-side only)
# OPENAI_API_KEY — OpenAI API key (server-side only, used by Edge Functions)
#
# For seeding scripts, pass them inline:
#   SUPABASE_URL=... SUPABASE_SERVICE_ROLE_KEY=... OPENAI_API_KEY=... node supabase/scripts/seed-bible.js

# PostHog Analytics
EXPO_PUBLIC_POSTHOG_API_KEY=phc_YOUR_POSTHOG_PROJECT_KEY
EXPO_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Sentry Error Tracking
EXPO_PUBLIC_SENTRY_DSN=https://YOUR_DSN@sentry.io/YOUR_PROJECT
