# Supabase Configuration
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# RevenueCat Configuration
# Public SDK API key from RevenueCat dashboard
# It starts with "appl_" for iOS and "goog_" for Android
EXPO_PUBLIC_REVENUECAT_APPLE_KEY=appl_YOUR_APPLE_KEY_HERE
EXPO_PUBLIC_REVENUECAT_GOOGLE_KEY=goog_YOUR_GOOGLE_KEY_HERE

# RevenueCat Webhook Configuration (for Supabase Edge Functions)
# Generate this in RevenueCat Dashboard > Project Settings > Integrations > Webhooks
# Used to verify webhook signatures for security
REVENUECAT_WEBHOOK_SECRET=whsec_YOUR_WEBHOOK_SECRET_HERE

# RevenueCat REST API Key (optional - for server-side verification)
# Generate in RevenueCat Dashboard > Project Settings > API Keys
# Only needed if using direct API verification (adds latency)
REVENUECAT_API_KEY=sk_YOUR_API_KEY_HERE

# For seeding scripts and migrations
SUPABASE_URL=https://your-project.supabase.co
OPENAI_API_KEY=sk-proj-YOUR_OPENAI_API_KEY_HERE
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here
