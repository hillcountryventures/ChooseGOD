{
  "expo": {
    "name": "ChooseGOD",
    "slug": "ChooseGOD",
    "scheme": "choosegod",
    "version": "1.1.0",
    "orientation": "portrait",
    "icon": "./assets/app-icon.png",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0F0F0F"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.choosegod.app",
      "associatedDomains": [
        "applinks:choosegod.app"
      ],
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSSpeechRecognitionUsageDescription": "Allow ChooseGOD to use speech recognition for hands-free questions and prayers.",
        "NSMicrophoneUsageDescription": "Allow ChooseGOD to use the microphone for voice input."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0F0F0F"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.choosegod.app",
      "permissions": [
        "android.permission.RECORD_AUDIO"
      ],
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "choosegod.app",
              "pathPrefix": "/verse"
            },
            {
              "scheme": "https",
              "host": "choosegod.app",
              "pathPrefix": "/refer"
            },
            {
              "scheme": "https",
              "host": "choosegod.app",
              "pathPrefix": "/invite"
            }
          ],
          "category": ["BROWSABLE", "DEFAULT"]
        }
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-secure-store",
      "@react-native-community/datetimepicker",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0F0F0F",
          "image": "./assets/splash-icon.png",
          "imageWidth": 200
        }
      ],
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Allow ChooseGOD to use the microphone for voice input.",
          "speechRecognitionPermission": "Allow ChooseGOD to use speech recognition for hands-free questions and prayers."
        }
      ],
      [
        "@sentry/react-native",
        {
          "url": "https://sentry.io/",
          "organization": "choosegod",
          "project": "choosegod-react-native",
          "dsn": "https://PLACEHOLDER@o0.ingest.sentry.io/0"
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "50d7d10e-37a3-49be-90cb-1f5f96ea070c"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/50d7d10e-37a3-49be-90cb-1f5f96ea070c"
    }
  }
}
